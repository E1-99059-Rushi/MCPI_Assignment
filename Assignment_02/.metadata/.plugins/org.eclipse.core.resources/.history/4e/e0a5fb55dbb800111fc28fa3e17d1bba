#ifndef MY_LED_C_
#define MY_LED_C_
#include "my_Led.h"

void init_led()
{

	RCC->AHB1ENR |= BV(3);

	GPIOD->MODER |= (BV(24)  | BV(28) );
	GPIOD->MODER &= ~ (BV(25) | BV(29) );

	GPIOD->OTYPER &= ~( BV(12) | BV(14) );

	GPIOD->OSPEEDR &= ~( BV(24) | BV(25) | BV(28) | BV(29));

	GPIOD->PUPDR &= ~ (BV(24) | BV(25) |BV(28) | BV(29));

	GPIOD->ODR |= (BV(12 ) | BV(14) );

}


void led_off_pin()
{
	GPIOD->ODR &=~ BV(12);
	DelayMs(1000);

}
void led_on_pin()
{
	GPIOD->ODR |= BV(12);
		DelayMs(1000);
}

void switch_press()
{
	GPIOD->ODR |= BV(14);
		DelayMs(1000);
	GPIOD->ODR &=~ BV(14);
				DelayMs(1000);
}

#endif /* MY_LED_C_ */
