#ifndef MY_LED_C_
#define MY_LED_C_
#include "my_Led.h"

void led_init()
{

	RCC->AHB1ENR |= BV(3);

	GPIO->MODER |= BV(24) | BV(26) | BV(28) | BV(30);
	GPIO->MODER &= ~ BV(25) |BV(27) | BV(29) | BV(31);

	GPIO->OTYPER &= ~ BV(12) | BV(13) | BV(14) | BV(15);

	GPIO->OSPPEDR &= ~ BV(24) | BV(25) | BV(26) | BV(27) | BV(28) | BV(29) | BV(30) | BV(31);

	GPIO->PUPDR &= ~ BV(24) | BV(25) | BV(26) | BV(27) | BV(28) | BV(29) | BV(30) | BV(31);


}



}
#endif /* MY_LED_C_ */
