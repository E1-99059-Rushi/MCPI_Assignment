#include "my_Led.h"

void my_switch()
{

	RCC->AHB1ENR |= BV(0);

	GPIOA->MODER &=~ (BV(0) | BV(1));

	GPIOA->OTYPER &= ~BV(0);

	GPIOA->OSPEER &=~ (BV(0) | BV(1));

	GPIOA->PUPDR  &=~ (BV(0) | BV(1));

	GPIOA->IDR |= BV(0);

	//INIT EXTERNAL INTERRUPT
	RCC->APB2ENR |= BV(14);

	SYSCFG->EXTICR[0] &=~ (BV(0)| BV(1)| BV(2)| BV(3));

	EXIT->IMR |=BV(0);

	EXIT->FTSR | BV(0);

	EXIT->RTST &=~ BV(0);





}

