#include "my_Led.h"

void init_switch()
{

	RCC->AHB1ENR |= BV(0);

	GPIOA->MODER &=~ (BV(0) | BV(1));

	GPIOA->OTYPER &= ~BV(0);

	GPIOA->OSPEEDR &=~ (BV(0) | BV(1));

	GPIOA->PUPDR  &=~ (BV(0) | BV(1));

	GPIOA->IDR |= BV(0);

	//INIT EXTERNAL INTERRUPT
	RCC->APB2ENR |= BV(14);

	SYSCFG->EXTICR[0] &=~ (BV(0)| BV(1)| BV(2)| BV(3));

	EXIT->IMR |=BV(0);

	EXIT->FTSR | BV(0);

	EXIT->RTST &=~ BV(0);

	NVIC_EnableIRQ(EXTI0_IRQn);


	void EXTI0_IRQHandler()
	{
		//clear pending bit for EXTI0 interrupt ,It clears the interrupt pending bit for EXTI line 0, allowing future interrupts to be detected and processed.
		//To clear the pending bit, you write a 1 to the corresponding bit in the EXTI_PR register.
		EXTI->PR |= BV(0);

		//Interrupt service routine code for EXTI0 interrupt
		led_on_pin();


	}
	int switch_press()
	{
		return BV(0)& GPIOA->IDR ? 1 : 0 ;
		//return 1 if switch is pressed,
		//return 0 if switch is not pressed
	}

}

